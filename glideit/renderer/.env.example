# Vite environment variables for GlideIt Renderer
# Copy this file to .env.local and modify as needed.

# When set to 'true', the renderer builds as a single self-contained HTML file
# with the graph data injected inline. This is useful for sharing a single file
# without needing a web server.
# Valid values: true, false
# Default: false (produces separate JS/CSS/JSON assets)
VITE_SINGLE_FILE=false
